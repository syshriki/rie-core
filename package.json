{
    "name": "rie-server",
    "version": "1.0.0",
    "description": "Recipe Information Exchange Server",
    "type": "module",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.ts",
        "prod": "NODE_ENV=prod node src/server.ts",
        "check": "tsc --noEmit",
        "test": "NODE_ENV=test mocha",
        "lint": "biome lint .",
        "openapi": "node scripts/aggregate-openapi.js",
        "gen-client": "npm run openapi && npx @hey-api/openapi-ts -c @hey-api/client-fetch -i openapi.yaml -o client/"
    },
    "dependencies": {
        "@koa/cors": "^5.0.0",
        "config": "^3.3.9",
        "jose": "^6.0.11",
        "jwks-rsa": "^3.0.1",
        "koa": "^3.0.0",
        "koa-bodyparser": "^4.4.1",
        "koa-cors": "^0.0.16",
        "koa-pino-logger": "^4.0.0",
        "koa-router": "^12.0.0",
        "lodash": "^4.17.21",
        "pino": "^9.7.0",
        "pino-pretty": "^13.0.0",
        "postgres": "^3.4.7",
        "zod": "^3.22.2"
    },
    "devDependencies": {
        "@hey-api/openapi-ts": "^0.99.0",
        "@types/chai": "^5.2.2",
        "@types/config": "^3.3.5",
        "@types/koa": "^2.15.0",
        "@types/koa-bodyparser": "^4.3.12",
        "@types/koa-cors": "^0.0.6",
        "@types/koa-logger": "^3.1.5",
        "@types/koa-pino-logger": "^3.0.4",
        "@types/koa-router": "^7.4.8",
        "@types/lodash": "^4.17.20",
        "@types/mocha": "^10.0.10",
        "@types/node": "^22.15.21",
        "@types/sinon": "^17.0.4",
        "@types/supertest": "^6.0.3",
        "biome": "^0.3.3",
        "chai": "^4.3.7",
        "js-yaml": "^5.2.2",
        "mocha": "^10.2.0",
        "nock": "^14.0.5",
        "nodemon": "^3.0.1",
        "sinon": "^15.2.0",
        "supertest": "^6.3.3",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0"
    },
    "engines": {
        "node": ">=24.1.0"
    }
}
