{
    "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
    "organizeImports": {
        "enabled": true
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "correctness": {
                "noUnusedVariables": "error"
            },
            "style": {
                "useTemplate": "error",
                "noParameterAssign": "error",
                "useSelfClosingElements": "error"
            },
            "suspicious": {
                "noConsoleLog": "warn",
                "noDoubleEquals": "error"
            },
            "complexity": {
                "noBannedTypes": "error",
                "noVoid": "error"
            }
        }
    },
    "formatter": {
        "enabled": true,
        "indentWidth": 2,
        "indentStyle": "space",
        "lineWidth": 100
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always",
            "quoteProperties": "asNeeded"
        }
    }
}